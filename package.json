{
  "name": "barycenter",
  "version": "0.0.0",
  "private": true,
  "description": "Control plane for nginx — HTTP/TCP/UDP reverse proxying and load balancing",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "verify": "./scripts/verify.sh",
    "verify:quick": "./scripts/verify.sh --quick",
    "test": "vitest run tests/unit",
    "test:conformance": "vitest run tests/conformance",
    "test:model": "vitest run tests/model",
    "mutate": "node scripts/mutate.mjs",
    "test:watch": "vitest tests/unit",
    "test:golden": "vitest run tests/golden --no-file-parallelism",
    "test:e2e": "vitest run tests/e2e --no-file-parallelism",
    "test:engine": "./tests/engine/run.sh",
    "typecheck": "tsc --noEmit",
    "test:store": "vitest run tests/store --no-file-parallelism",
    "test:driver": "node scripts/driver-compat.mjs",
    "test:install": "./tests/install/run.sh",
    "build": "./scripts/build.sh",
    "token": "node scripts/token.mjs",
    "quickstart": "./scripts/quickstart.sh",
    "soak": "node scripts/soak.mjs",
    "typecheck:ts5": "node node_modules/typescript-5/bin/tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "typescript-5": "npm:typescript@^5.9.3",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "pg": "^8.23.0"
  },
  "bin": {
    "barycenterd": "./dist/bin/barycenterd.js",
    "bary": "./dist/bin/bary.js",
    "bary-dp-agent": "./dist/bin/bary-dp-agent.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "drivers",
    "README.md",
    "DESIGN.md",
    "LICENSE"
  ]
}
