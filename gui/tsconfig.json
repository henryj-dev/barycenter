{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": ["svelte", "vite/client"],
    "paths": { "@web/*": ["../src/web/*"] }
  },
  "include": ["src/**/*.ts", "src/**/*.svelte", "vite.config.ts"]
}
