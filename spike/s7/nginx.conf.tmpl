# S7 — 활성화 판정 스파이크 (DESIGN.md §12.0, §6.3)
#
# ⚠️ 버릴 코드다.
#
# 답해야 할 질문: **새 세대가 실제로 활성화됐는지 어떻게 증명하는가.**
#
# E23 이 이미 보여줬다 — 포트가 점유돼 있으면 `nginx -t` 는 통과하고, HUP 후에도 마스터는
# 살아 있으며 nginx 는 **옛 설정으로 계속 서비스한다**. 마스터 생존과 소켓 존재는 증거가
# 아니다. 여기서는 판정 절차를 실제로 만들어 오탐/미탐 0 을 확인한다.
#
# 재현하는 구조
#   · 세대에 구워진 리터럴 __GEN__ (§6.3-4). shared dict 가 아니다.
#   · 워커 레지스트리 — 각 워커가 {pid → 세대:하트비트} 를 남긴다.
#     그래야 "워커 하나"가 아니라 "모든 워커"를 판정할 수 있다.
#   · 대조군으로 **일부러 틀린** shared marker 도 함께 둔다 (A4.3).

worker_processes 3;
daemon off;
error_log logs/error.log warn;
events { worker_connections 256; }

http {
    access_log off;
    lua_shared_dict bary 1m;

    init_worker_by_lua_block {
        -- 이 세대의 정체. 렌더 시점에 고정된다.
        _G.GEN = __GEN__

        if ngx.worker.id() and ngx.worker.id() >= 0 then
            local d = ngx.shared.bary

            -- A4.3 대조군: shared dict 에 "현재 세대"를 쓰면 **옛 워커도 새 값을 읽는다.**
            -- 즉 이걸로는 어느 세대가 응답했는지 알 수 없다. 아래 /slow 가 이를 드러낸다.
            d:set("shared_marker", _G.GEN)

            local pid = ngx.worker.pid()
            local function beat()
                ngx.update_time()
                d:set("w:" .. pid, _G.GEN .. ":" .. ngx.now())
            end
            beat()
            assert(ngx.timer.every(0.2, beat))
        end
    }

    server { listen 127.0.0.1:9001; location / { return 200 "BACKEND"; } }

    server {
        listen 127.0.0.1:8081;

        # HUP 직전에 찍는다. 이후 경과 시간의 기준점이자 error log 워터마크.
        location /mark {
            content_by_lua_block {
                ngx.update_time()
                ngx.shared.bary:set("mark_at", ngx.now())
                ngx.say("marked")
            }
        }

        # 런타임 관측: 살아 있는 워커를 세대별로 집계한다.
        #   accepting  = 살아 있는 워커 중 가장 최근 세대
        #   serving[]  = 살아 있는 워커가 있는 모든 세대
        location /runtime {
            content_by_lua_block {
                local d = ngx.shared.bary
                ngx.update_time()
                local now = ngx.now()
                local gens, accepting = {}, -1
                for _, k in ipairs(d:get_keys(2048)) do
                    if k:sub(1, 2) == "w:" then
                        local v = d:get(k)
                        if v then
                            local g, t = v:match("^(%d+):([%d%.]+)$")
                            -- 하트비트가 끊긴 워커는 이미 죽은 것이다. 세지 않는다.
                            if g and (now - tonumber(t)) < 1.0 then
                                g = tonumber(g)
                                gens[g] = (gens[g] or 0) + 1
                                if g > accepting then accepting = g end
                            end
                        end
                    end
                end
                local parts = {}
                for g, n in pairs(gens) do parts[#parts + 1] = g .. "=" .. n end
                table.sort(parts)
                local mark = d:get("mark_at")
                ngx.say("expected=", ngx.worker.count(),
                        " accepting=", accepting,
                        " serving=", table.concat(parts, ","),
                        " elapsed_ms=", mark and math.floor((now - mark) * 1000 + 0.5) or -1,
                        " shared_marker=", d:get("shared_marker") or -1)
            }
        }
    }

    server {
        listen 127.0.0.1:8080;
        location / { proxy_pass http://127.0.0.1:9001; }

        # HUP 을 가로지르는 in-flight 요청. 응답한 워커의 정체를 두 방식으로 보고한다.
        location /slow {
            content_by_lua_block {
                ngx.sleep(3)
                ngx.print("baked=", _G.GEN, " shared=", ngx.shared.bary:get("shared_marker") or -1)
            }
        }
    }

    # __EXTRA_LISTEN__ — 러너가 여기에 충돌할 리스너를 심는다.
}
